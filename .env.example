# Copy to .env (same folder as docker-compose.yml) and change the password
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=housedb

# Host ports
API_PORT=8080
PMA_PORT=8082
DB_PORT=3307

# Development exposes the OpenAPI doc at /openapi/v1.json
ASPNETCORE_ENVIRONMENT=Development

# Signing key for the JWTs (at least 32 characters)
JWT_KEY=change-me-to-a-long-random-secret-key-123456

# Public address of the API, used as the server URL in Swagger
API_BASE_URL=https://api.satoriservices.nl
